# Copia este archivo a .env y rellena valores (no subas .env al repo).
# Todo va en la raiz del proyecto (junto a package.json).

# Puerto HTTP (por defecto 3000). Si GET /api/auth/me devuelve {"error":"No autenticado."} o
# no ves "libroai":true en el JSON, otro programa esta usando ese puerto: pon PORT=3100 (por ejemplo).
# PORT=3100

# Pruebas sin login (opcional):
# SKIP_AUTH=true
# BILLING_RELAXED=true
# DEV_USER_ID=1
#
# Uso normal: SKIP_AUTH=false

ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REFINE_MODEL=claude-sonnet-4-5-20250929

SESSION_SECRET=cambia-esto-en-produccion-largo-y-aleatorio
BILLING_CYCLE_DAYS=30
DEFAULT_SEED_EMAIL=demo@libroai.app

# Google Sign-In: Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth (aplicacion web)
# Origenes autorizados de JavaScript: http://localhost:3000
GOOGLE_CLIENT_ID=

# Stripe (cuando lo actives)
STRIPE_WEBHOOK_SECRET=

# Firebase (proyecto en Firebase Console > Configuración del proyecto > Tus apps > SDK de Firebase)
# Estas variables las sirve /api/config/firebase al cliente — NO las pongas hardcodeadas en index.html.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
